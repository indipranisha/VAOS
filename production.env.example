# Copy to production.env and replace every example value. Do not commit production.env.
VAOS_ADMIN_DOMAIN=vaos-admin.example.com
VAOS_CAMERA_DOMAIN=vaos-camera.example.com
VAOS_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_SECRET_OF_AT_LEAST_32_CHARACTERS
VAOS_INTERNAL_STATUS_TOKEN=REPLACE_WITH_A_DIFFERENT_UNIQUE_SECRET_OF_AT_LEAST_32_CHARACTERS
VAOS_INSTALL_OBJECT_DETECTION=true
OBJECT_DETECTOR_DEVICE=auto
# Optional GPU deployment: set this to the CUDA wheel index for your server's supported PyTorch build.
# See https://pytorch.org/get-started/locally/ and use the same value for both services.
# VAOS_TORCH_INDEX_URL=https://download.pytorch.org/whl/cuXXX
